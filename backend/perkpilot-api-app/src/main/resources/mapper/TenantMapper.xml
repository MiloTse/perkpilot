<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.perkpilot.api.tenant.TenantMapper">

    <resultMap id="TenantResultMap" type="com.perkpilot.api.tenant.Tenant">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true"
            keyProperty="id,createdAt,updatedAt"
            keyColumn="id,created_at,updated_at">
        INSERT INTO tenant (code, name, status, created_at, updated_at)
        VALUES (#{code}, #{name}, #{status}, NOW(), NOW())
    </insert>

    <select id="findById" resultMap="TenantResultMap">
        SELECT id, code, name, status, created_at, updated_at
        FROM tenant
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="TenantResultMap">
        SELECT id, code, name, status, created_at, updated_at
        FROM tenant
        ORDER BY id
    </select>

    <update id="update">
        UPDATE tenant
        SET name = #{name},
        status = #{status},
        updated_at = NOW()
        WHERE id = #{id}
    </update>
</mapper>